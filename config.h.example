// config.h.example - copy this file to config.h and fill in your own values.
// config.h is .gitignore'd so your secrets never leave your machine.

#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// --- MQTT broker ------------------------------------------------------------
#define MQTT_HOST       "broker.hivemq.com"
#define MQTT_PORT       1883
#define MQTT_CLIENT_ID  "fluidwire-esp32-noticeboard"
#define MQTT_USER       ""
#define MQTT_PASSWORD   ""

// Topic the notice board listens to. Publish any text to it and it appears
// on the OLED. Use a unique name - public brokers are shared by everyone.
#define MQTT_TOPIC_MESSAGE "fluidwire/demo/noticeboard/message"
